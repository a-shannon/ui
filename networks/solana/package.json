{
  "name": "@rosen-network/solana",
  "version": "0.0.0",
  "private": true,
  "description": "Solana source lock transaction preparation for Rosen Bridge UI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/ui.git",
    "directory": "./networks/solana"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "browser": {
    "ergo-lib-wasm-nodejs": "./dist/ergo-address-browser.mjs",
    "@solana/spl-token": "./dist/spl-token-browser.mjs"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build && node ./scripts/build-browser-adapters.mjs",
    "lint": "biome check --write",
    "lint:check": "biome check",
    "prepack": "npm run build",
    "test": "cross-env NODE_OPTIONS=--import=tsx vitest run",
    "type-check": "tsc --noEmit -p tsconfig.tests.json"
  },
  "dependencies": {
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "bs58": "6.0.0",
    "buffer": "6.0.3",
    "ergo-lib-wasm-nodejs": "0.24.1"
  },
  "devDependencies": {
    "@rosen-bridge/address-codec": "^2.1.0",
    "cross-env": "^10.1.0",
    "ergo-lib-wasm-browser": "0.24.1",
    "esbuild": "0.25.10",
    "tsx": "^4.19.2",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
