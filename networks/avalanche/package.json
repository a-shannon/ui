{
  "name": "@rosen-network/avalanche",
  "version": "0.0.0",
  "private": true,
  "description": "Avalanche C-Chain native and ERC20 network support for Rosen Bridge UI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/ui.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "coverage": "NODE_OPTIONS='--import tsx' vitest run --coverage",
    "lint:check": "biome check",
    "test": "NODE_OPTIONS='--import tsx' vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@rosen-bridge/icons": "^4.0.0",
    "@rosen-bridge/tokens": "^6.0.2",
    "@rosen-network/base": "^0.5.5",
    "@rosen-network/evm": "^0.3.8",
    "@rosen-ui/constants": "^1.1.0",
    "@rosen-ui/utils": "^1.2.0",
    "ethers": "6.16.0"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
